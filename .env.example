# Copy to .env and fill in. .env is gitignored and kept out of image layers by
# .dockerignore, so credentials never reach a published image.
#
#   docker run --env-file ./.env -p 3000:3000 ghcr.io/kristofer84/tp-link-modem-router

# --- router, used by every entry point ---
ROUTER_URL=http://192.168.1.1
ROUTER_LOGIN=admin
ROUTER_PASSWORD=

# --- api-bridge.js ---
# HTTP basic auth for the bridge's own API: user:password[,user:password...]
API_USERS=apiuser:pleasechangeme
API_LISTEN_HOST=0.0.0.0
API_LISTEN_PORT=3000
# how long POST /sms/outbox?verify=true waits for the router to settle
#SMS_VERIFY_TIMEOUT_MS=5000
#SMS_VERIFY_INTERVAL_MS=500

# --- sms-cat.js (polls the bridge above for incoming SMS) ---
#API_CLIENT_URL=http://localhost:3000
#API_CLIENT_LOGIN=apiuser
#API_CLIENT_PASSWORD=pleasechangeme
#API_CLIENT_POLLING_DELAY=5000

# --- smtp-gateway.js ---
#SMS_GATEWAY_URL=http://localhost:3000
#SMS_GATEWAY_LOGIN=apiuser
#SMS_GATEWAY_PASSWORD=pleasechangeme
#SMS_GATEWAY_DOMAIN=smtp2sms.local
#SMS_GATEWAY_LISTEN_HOST=0.0.0.0
#SMS_GATEWAY_LISTEN_PORT=1025

# --- logging ---
# json for services, text for the CLI; both overridable here
#LOG_FORMAT=json
#LOG_LEVEL=info
